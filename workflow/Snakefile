# Fidelis workflow. Run it through uv so jobs use the project venv:
#
#   uv run snakemake --profile profiles/local smoke   # laptop GPU
#   uv run snakemake --profile profiles/carc smoke    # CARC, through SLURM
#
# Rules declare what they need (GPUs, memory, time); the profile decides where it
# runs: the account, partition, and pinned GPU model live in profiles/carc.


# Every core library does real GPU work and checks it against a known answer.
# No output file, so `snakemake smoke` reruns it every time. The PASS/FAIL lines
# go to the console locally and to the job log on SLURM.
rule smoke:
    resources:
        gpu=1,
        cpus_per_task=4,
        mem_mb=16000,
        runtime=30,  # minutes; the first run compiles gsplat (~6 min on the laptop)
    envmodules:
        # Only loaded with --software-deployment-method env-modules (the CARC profile).
        # cuda/13.0.3 only loads after these two (`module spider cuda/13.0.3`).
        "ver/2607",
        "gcc/15.3.0",
        "cuda/13.0.3",  # nvcc for gsplat's JIT build; must share torch's CUDA major (13)
    shell:
        "nvidia-smi && fidelis-smoke"
