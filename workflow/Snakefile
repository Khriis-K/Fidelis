# Fidelis workflow. Run it through uv so jobs use the project venv:
#
#   uv run snakemake --profile profiles/local smoke   # laptop GPU
#   uv run snakemake --profile profiles/carc smoke    # CARC, through SLURM
#
# Rules declare what they need (GPUs, memory, time); the profile decides where it
# runs: the account, partition, and pinned GPU model live in profiles/carc.

# CARC modules for any rule that builds CUDA code. Only loaded with
# --software-deployment-method env-modules (the CARC profile).
CUDA_MODULES = [
    # cuda/13.0.3 only loads after these two (`module spider cuda/13.0.3`).
    "ver/2607",
    "gcc/15.3.0",
    "cuda/13.0.3",  # nvcc for gsplat's JIT build; must share torch's CUDA major (13)
]

configfile: "config/jezero.yaml"

CONFIG = "config/jezero.yaml"


# Rules take the config file as ancient(): its timestamp never reruns them, so a comment
# or another rule's setting can't send the scene or a splat back through the queue. What
# a rule does read goes in its params, and Snakemake reruns it when those change.
def config_values(*keys):
    return {key: config[key] for key in keys}


# The matching map's resolutions, without their source notes: rewording a citation changes nothing.
MAP_RESOLUTIONS = {
    key: config["matching_map"][key]["value_m"] for key in ("lvs_map_resolution", "ctx_ground_resolution")
}
# What fidelis-plain-mc and fidelis-match-viz read: the sampler, the simulator, the run.
# Not map_offset or matching_map.source: the Monte Carlo rules below are pinned to the scene's
# own map (OLD_MAP), whose offset is zero by construction.
MC_CONFIG = config_values("plain_mc", "scenario", "simulation", "suns", "tile", "scene")
# The plain_mc* and match_viz rules made the results from before #36, on seeds 0-19, against
# the scene's own map. They stay on it: on the CTX map they would overwrite those results and
# spend seeds the CTX scans must not have seen. Scans on the CTX map are pre-registered and
# run by hand (docs/benchmarks/ctx-map-scan.md).
OLD_MAP = "--matching-map scene"


JEZERO = "data/jezero"

localrules:
    preflight,
    jezero,
    # CARC compute nodes have no internet, so downloads run where Snakemake was
    # launched (a login node on CARC; see docs/carc.md).
    download_mosaic,


# Runs where Snakemake was launched (the CARC login node), with the same modules as
# the GPU job, so a broken module line fails in seconds instead of after a queue wait.
# Both profiles set `forcerun: [preflight]`, so it checks again on every invocation.
# That also reruns everything downstream of it, so only always-run entry rules like
# smoke should depend on it, never a rule with expensive outputs.
rule preflight:
    output:
        touch("logs/preflight.ok"),
    envmodules:
        *CUDA_MODULES,
    shell:
        "fidelis-preflight"


# Every core library does real GPU work and checks it against a known answer.
# No output file, so `snakemake smoke` reruns it every time. The PASS/FAIL lines
# go to the console locally and to the job log on SLURM.
rule smoke:
    input:
        rules.preflight.output,
    resources:
        gpu=1,
        cpus_per_task=4,
        mem_mb=16000,
        runtime=30,  # minutes; the first run compiles gsplat (~6 min on the laptop)
    envmodules:
        *CUDA_MODULES,
    shell:
        "nvidia-smi && fidelis-smoke"


# The Jezero test scene from public USGS data: one command, `snakemake jezero`.
rule jezero:
    input:
        f"{JEZERO}/scene/ring.json",
        f"{JEZERO}/matching_map/map.tif",
        f"{JEZERO}/lvs_map/map.tif",
        f"{JEZERO}/mesh/mesh.ply",
        f"{JEZERO}/mesh/ring.ply",


# Snakemake deletes a job's outputs before rerunning it, which would throw away a
# multi-GB mosaic that only needed re-checking. So the output is a small record of
# the verified hash, and fidelis-fetch keeps the .tif when its hash still matches.
rule download_mosaic:
    output:
        f"{JEZERO}/raw/{{mosaic}}.verified",
    wildcard_constraints:
        mosaic="dtm|ortho|ctx_dtm|ctx_ortho",
    params:
        url=lambda w: config["mosaics"][w.mosaic]["url"],
        tif=lambda w: f"{JEZERO}/raw/{w.mosaic}.tif",
        pin=lambda w: f"--sha256 {sha}" if (sha := config["mosaics"][w.mosaic]["sha256"]) else "",
    shell:
        "fidelis-fetch {params.url} {params.tif} {params.pin} --record {output}"


rule jezero_tile:
    input:
        f"{JEZERO}/raw/dtm.verified",
        f"{JEZERO}/raw/ortho.verified",
        ancient(CONFIG),
    params:
        config_used=config_values("tile", "mars_radius_m") | MAP_RESOLUTIONS,
    output:
        f"{JEZERO}/tile/dtm.tif",
        f"{JEZERO}/tile/ortho.tif",
        f"{JEZERO}/tile/tile.json",
    resources:
        mem_mb=4000,
    shell:
        f"fidelis-tile config/jezero.yaml {JEZERO}/raw/dtm.tif {JEZERO}/raw/ortho.tif {JEZERO}/tile"


# The wide scene (#33): a CTX ring around the tile, brightness-matched, with the tile's
# heights and texture eased into it at the edge.
rule jezero_scene:
    input:
        f"{JEZERO}/tile/dtm.tif",
        f"{JEZERO}/tile/ortho.tif",
        f"{JEZERO}/tile/tile.json",
        f"{JEZERO}/raw/ctx_dtm.verified",
        f"{JEZERO}/raw/ctx_ortho.verified",
        ancient(CONFIG),
    params:
        config_used=config_values("scene", "mars_radius_m"),
    output:
        f"{JEZERO}/scene/dtm.tif",
        f"{JEZERO}/scene/ortho.tif",
        f"{JEZERO}/scene/tile.json",
        f"{JEZERO}/scene/ring_dtm.tif",
        f"{JEZERO}/scene/ring_ortho.tif",
        f"{JEZERO}/scene/ring.json",
    resources:
        mem_mb=8000,
    shell:
        f"fidelis-scene config/jezero.yaml {JEZERO}/tile {JEZERO}/raw/ctx_dtm.tif {JEZERO}/raw/ctx_ortho.tif"
        f" {JEZERO}/scene"


# The ground-truth scene: one vertex per DTM pixel, textured with the orthoimage, in
# ground metres (tile.json carries the east-west scale and curvature), plus the ring.
rule jezero_mesh:
    input:
        rules.jezero_scene.output,
    output:
        f"{JEZERO}/mesh/mesh.ply",
        f"{JEZERO}/mesh/texture.png",
        f"{JEZERO}/mesh/ring.ply",
        f"{JEZERO}/mesh/ring_texture.png",
        f"{JEZERO}/mesh/mesh.json",
    resources:
        mem_mb=4000,
    shell:
        f"fidelis-mesh {JEZERO}/scene {JEZERO}/mesh"


# The tile's texture with its baked terrain shading divided out (#19). CPU only. Not an
# input of `jezero` or of any Monte Carlo rule: results so far rendered from texture.png,
# and a new input would send them back through the queue.
rule jezero_deshaded_texture:
    input:
        f"{JEZERO}/scene/dtm.tif",
        f"{JEZERO}/scene/ortho.tif",
        f"{JEZERO}/scene/tile.json",
        ancient(CONFIG),
    params:
        # Without the check sun's source note: rewording a citation changes nothing.
        config_used={
            **config["deshade"],
            "check_sun": {k: v for k, v in config["deshade"]["check_sun"].items() if k != "source"},
        },
    output:
        f"{JEZERO}/mesh/texture_deshaded.png",
        f"{JEZERO}/mesh/texture_deshaded.json",
    resources:
        mem_mb=8000,
    shell:
        f"fidelis-deshade config/jezero.yaml {JEZERO}/scene {{output[0]}}"


# The scene's own map: the orthoimage it renders, averaged to 6 m. Every result before #36
# matched against it; it stays so they reproduce (`fidelis-plain-mc --matching-map scene`),
# and the splat views read the ground height through it.
rule jezero_matching_map:
    input:
        rules.jezero_scene.output,
        ancient(CONFIG),
    params:
        config_used=MAP_RESOLUTIONS,
    output:
        f"{JEZERO}/matching_map/map.tif",
        f"{JEZERO}/matching_map/map.json",
    resources:
        mem_mb=4000,
    shell:
        f"fidelis-matching-map config/jezero.yaml {JEZERO}/scene {{output[0]}}"


# The real LVS map (#36): the raw CTX orthomosaic's own pixels under the scene's footprint.
# Nothing HiRISE-derived goes in: only the ring's bounds and the east-west ground scale.
rule jezero_lvs_map:
    input:
        f"{JEZERO}/scene/ring.json",
        f"{JEZERO}/scene/tile.json",
        f"{JEZERO}/raw/ctx_ortho.verified",
        ancient(CONFIG),
    params:
        config_used={"lvs_map_resolution": MAP_RESOLUTIONS["lvs_map_resolution"]},
    output:
        f"{JEZERO}/lvs_map/map.tif",
        f"{JEZERO}/lvs_map/map.json",
    resources:
        mem_mb=4000,
    shell:
        f"fidelis-lvs-map config/jezero.yaml {JEZERO}/scene {JEZERO}/raw/ctx_ortho.tif {{output[0]}}"


# The whole-map offset between the LVS map (CTX) and the HiRISE tile the scene renders (#40),
# by registering the two orthoimages. CPU only, a few minutes. The result is copied by hand
# into config/jezero.yaml's ctx_map_offset, with docs/benchmarks/map-offset.md as its source.
rule jezero_map_offset:
    input:
        f"{JEZERO}/tile/ortho.tif",
        f"{JEZERO}/tile/tile.json",
        f"{JEZERO}/raw/ctx_ortho.verified",
    output:
        f"{JEZERO}/map_offset/offset.json",
    resources:
        mem_mb=4000,
    shell:
        f"fidelis-map-offset {JEZERO}/tile {JEZERO}/raw/ctx_ortho.tif {{output}}"


# The first end-to-end estimate: N seeded descents through the mesh renderer and the
# navigator, then P(fail) with a Wilson interval: no fix, or a miss beyond r = 40 m in the
# map frame (ADR 0003). Each record reruns from its seed. `snakemake plain_mc`.
rule plain_mc:
    input:
        rules.jezero.input,
        ancient(CONFIG),
    params:
        config_used=MC_CONFIG,
    output:
        "results/plain_mc/records.jsonl",
        "results/plain_mc/estimate.json",
    resources:
        gpu=1,
        cpus_per_task=4,
        mem_mb=16000,
        runtime=60,
    shell:
        f"fidelis-plain-mc config/jezero.yaml {JEZERO} results/plain_mc {OLD_MAP}"


# The splat scene (#9): mesh renders from descent-camera views under one sun, then a
# gsplat scene trained on them and checked against held-out views. `snakemake splat`.
# Outputs live under data/, which on CARC is the clone on /project2 (docs/carc.md).
SPLAT = f"{JEZERO}/splat/sun{{sun}}"
SPLAT_SUN = config["splat"]["sun_index"]


rule splat:
    input:
        expand(f"{SPLAT}/splat.pt", sun=SPLAT_SUN),
        expand(f"{SPLAT}/quality.json", sun=SPLAT_SUN),


rule splat_views:
    input:
        rules.jezero.input,
        ancient(CONFIG),
    params:
        config_used=config_values("scenario", "suns", "tile", "scene") | {"views": config["splat"]["views"]},
    output:
        f"{SPLAT}/views/train.npy",
        f"{SPLAT}/views/heldout.npy",
        f"{SPLAT}/views/views.json",
    wildcard_constraints:
        sun=r"\d+",
    resources:
        gpu=1,
        cpus_per_task=4,
        mem_mb=16000,
        runtime=60,
    shell:
        f"fidelis-splat-views config/jezero.yaml {JEZERO} {JEZERO}/splat/sun{{wildcards.sun}}/views"
        " --sun-index {wildcards.sun}"


rule splat_train:
    input:
        rules.splat_views.output,
        f"{JEZERO}/mesh/mesh.json",
        ancient(CONFIG),
    params:
        # Not log_every: how often training prints doesn't change the splat.
        config_used=config_values("suns") | {k: config["splat"][k] for k in ("steps", "ssim_weight", "quality")},
    output:
        f"{SPLAT}/splat.pt",
        f"{SPLAT}/splat.ply",
        f"{SPLAT}/quality.json",
    wildcard_constraints:
        sun=r"\d+",
    resources:
        gpu=1,
        cpus_per_task=8,
        mem_mb=64000,
        runtime=45,  # minutes; the first run took 12 min 49 s on an L40S (docs/benchmarks/splat.md)
    envmodules:
        *CUDA_MODULES,
    shell:
        f"fidelis-splat-train config/jezero.yaml {JEZERO}/splat/sun{{wildcards.sun}}/views {JEZERO}/mesh"
        f" {JEZERO}/splat/sun{{wildcards.sun}}"


# Plain Monte Carlo on the splat, every descent under the trained sun. `snakemake plain_mc_splat`.
rule plain_mc_splat:
    input:
        rules.jezero.input,
        rules.splat.input,
        ancient(CONFIG),
    params:
        config_used=MC_CONFIG,
    output:
        "results/plain_mc_splat/records.jsonl",
        "results/plain_mc_splat/estimate.json",
    resources:
        gpu=1,
        cpus_per_task=4,
        mem_mb=16000,
        runtime=60,
    envmodules:
        *CUDA_MODULES,
    shell:
        f"fidelis-plain-mc config/jezero.yaml {JEZERO} results/plain_mc_splat --fidelity splat --sun-index {SPLAT_SUN} {OLD_MAP}"


# The same seeds on the mesh, under the same pinned sun: plain_mc mixes all five suns, so
# only this run compares fidelity alone with plain_mc_splat. `snakemake plain_mc_mesh_pinned`.
rule plain_mc_mesh_pinned:
    input:
        rules.jezero.input,
        ancient(CONFIG),
    params:
        config_used=MC_CONFIG,
    output:
        "results/plain_mc_mesh_pinned/records.jsonl",
        "results/plain_mc_mesh_pinned/estimate.json",
    resources:
        gpu=1,
        cpus_per_task=4,
        mem_mb=16000,
        runtime=60,
    shell:
        f"fidelis-plain-mc config/jezero.yaml {JEZERO} results/plain_mc_mesh_pinned --fidelity mesh"
        f" --sun-index {SPLAT_SUN} {OLD_MAP}"


# The match picture for any seed, rerun from the config:
# `snakemake results/plain_mc/matches/seed_12.png`.
rule match_viz:
    input:
        rules.jezero.input,
        ancient(CONFIG),
    params:
        config_used=MC_CONFIG,
    output:
        "results/plain_mc/matches/seed_{seed}.png",
    wildcard_constraints:
        seed=r"\d+",
    resources:
        gpu=1,
        cpus_per_task=4,
        mem_mb=16000,
        runtime=20,
    shell:
        f"fidelis-match-viz config/jezero.yaml {JEZERO} {{wildcards.seed}} {{output}} {OLD_MAP}"
