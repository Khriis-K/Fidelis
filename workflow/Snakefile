# Fidelis workflow. Run it through uv so jobs use the project venv:
#
#   uv run snakemake --profile profiles/local smoke   # laptop GPU
#   uv run snakemake --profile profiles/carc smoke    # CARC, through SLURM
#
# Rules declare what they need (GPUs, memory, time); the profile decides where it
# runs: the account, partition, and pinned GPU model live in profiles/carc.

# CARC modules for any rule that builds CUDA code. Only loaded with
# --software-deployment-method env-modules (the CARC profile).
CUDA_MODULES = [
    # cuda/13.0.3 only loads after these two (`module spider cuda/13.0.3`).
    "ver/2607",
    "gcc/15.3.0",
    "cuda/13.0.3",  # nvcc for gsplat's JIT build; must share torch's CUDA major (13)
]

configfile: "config/jezero.yaml"


JEZERO = "data/jezero"

localrules:
    preflight,
    jezero,
    # CARC compute nodes have no internet, so downloads run where Snakemake was
    # launched (a login node on CARC; see docs/carc.md).
    download_mosaic,


# Runs where Snakemake was launched (the CARC login node), with the same modules as
# the GPU job, so a broken module line fails in seconds instead of after a queue wait.
# Both profiles set `forcerun: [preflight]`, so it checks again on every invocation.
# That also reruns everything downstream of it, so only always-run entry rules like
# smoke should depend on it, never a rule with expensive outputs.
rule preflight:
    output:
        touch("logs/preflight.ok"),
    envmodules:
        *CUDA_MODULES,
    shell:
        "fidelis-preflight"


# Every core library does real GPU work and checks it against a known answer.
# No output file, so `snakemake smoke` reruns it every time. The PASS/FAIL lines
# go to the console locally and to the job log on SLURM.
rule smoke:
    input:
        rules.preflight.output,
    resources:
        gpu=1,
        cpus_per_task=4,
        mem_mb=16000,
        runtime=30,  # minutes; the first run compiles gsplat (~6 min on the laptop)
    envmodules:
        *CUDA_MODULES,
    shell:
        "nvidia-smi && fidelis-smoke"


# The Jezero test scene from public USGS data: one command, `snakemake jezero`.
rule jezero:
    input:
        f"{JEZERO}/tile/tile.json",
        f"{JEZERO}/matching_map/map.tif",
        f"{JEZERO}/mesh/mesh.ply",


# Snakemake deletes a job's outputs before rerunning it, which would throw away a
# multi-GB mosaic that only needed re-checking. So the output is a small record of
# the verified hash, and fidelis-fetch keeps the .tif when its hash still matches.
rule download_mosaic:
    output:
        f"{JEZERO}/raw/{{mosaic}}.verified",
    wildcard_constraints:
        mosaic="dtm|ortho",
    params:
        url=lambda w: config["mosaics"][w.mosaic]["url"],
        tif=lambda w: f"{JEZERO}/raw/{w.mosaic}.tif",
        pin=lambda w: f"--sha256 {sha}" if (sha := config["mosaics"][w.mosaic]["sha256"]) else "",
    shell:
        "fidelis-fetch {params.url} {params.tif} {params.pin} --record {output}"


rule jezero_tile:
    input:
        f"{JEZERO}/raw/dtm.verified",
        f"{JEZERO}/raw/ortho.verified",
        "config/jezero.yaml",
    output:
        f"{JEZERO}/tile/dtm.tif",
        f"{JEZERO}/tile/ortho.tif",
        f"{JEZERO}/tile/tile.json",
    resources:
        mem_mb=4000,
    shell:
        f"fidelis-tile config/jezero.yaml {JEZERO}/raw/dtm.tif {JEZERO}/raw/ortho.tif {JEZERO}/tile"


# The ground-truth scene: one vertex per DTM pixel, textured with the orthoimage, in
# ground metres (tile.json carries the east-west scale).
rule jezero_mesh:
    input:
        f"{JEZERO}/tile/dtm.tif",
        f"{JEZERO}/tile/ortho.tif",
        f"{JEZERO}/tile/tile.json",
    output:
        f"{JEZERO}/mesh/mesh.ply",
        f"{JEZERO}/mesh/texture.png",
        f"{JEZERO}/mesh/mesh.json",
    resources:
        mem_mb=4000,
    shell:
        f"fidelis-mesh {JEZERO}/tile {JEZERO}/mesh"


rule jezero_matching_map:
    input:
        f"{JEZERO}/tile/ortho.tif",
        f"{JEZERO}/tile/tile.json",
        "config/jezero.yaml",
    output:
        f"{JEZERO}/matching_map/map.tif",
        f"{JEZERO}/matching_map/map.json",
    resources:
        mem_mb=4000,
    shell:
        f"fidelis-matching-map config/jezero.yaml {JEZERO}/tile {{output[0]}}"

# The first end-to-end estimate: N seeded descents through the mesh renderer and the
# navigator, then P(fail) with a Wilson interval at the config's PROVISIONAL r. Each
# record reruns from its seed. `snakemake plain_mc`.
rule plain_mc:
    input:
        rules.jezero.input,
        "config/jezero.yaml",
    output:
        "results/plain_mc/records.jsonl",
        "results/plain_mc/estimate.json",
    resources:
        gpu=1,
        cpus_per_task=4,
        mem_mb=16000,
        runtime=60,
    shell:
        f"fidelis-plain-mc config/jezero.yaml {JEZERO} results/plain_mc"


# The match picture for any seed, rerun from the config:
# `snakemake results/plain_mc/matches/seed_12.png`.
rule match_viz:
    input:
        rules.jezero.input,
        "config/jezero.yaml",
    output:
        "results/plain_mc/matches/seed_{seed}.png",
    wildcard_constraints:
        seed=r"\d+",
    resources:
        gpu=1,
        cpus_per_task=4,
        mem_mb=16000,
        runtime=20,
    shell:
        f"fidelis-match-viz config/jezero.yaml {JEZERO} {{wildcards.seed}} {{output}}"
